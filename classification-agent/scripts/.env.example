# Copy to .env and fill in real values — .env itself is gitignored.
# Loaded automatically by litellm (python-dotenv) when agent.py starts.
# Normally set once in the root .env (shared LLM_PROVIDER + all *_AGENT_MODEL
# vars) — this per-agent copy is only for running this agent standalone.

# LLM_PROVIDER picks the API: ollama | openrouter | openai | anthropic
LLM_PROVIDER=ollama

# Bare model name for whichever provider is active above, e.g.:
#   llama3.1                            (ollama, default, no API key needed)
#   anthropic/claude-sonnet-4.5         (openrouter — needs the org/ prefix, see openrouter.ai/models)
#   gpt-4o                              (openai)
#   claude-sonnet-5                     (anthropic)
CLASSIFICATION_AGENT_MODEL=llama3.1

# Only the key matching LLM_PROVIDER is needed — uncomment one.
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# This agent's own A2A auth (unrelated to the model provider key above).
# CLASSIFICATION_AGENT_API_KEY=
