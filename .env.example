# ════════════════════════════════════════════════════════════
#  Data Science Agents — environment variables
#  Copy this file to .env and fill in your values.
#  `make setup` does that and replaces the example devkey and JWT_SECRET.
#  The gateway and all ten agents read this same file.
# ════════════════════════════════════════════════════════════

# ── LLM ───────────────────────────────────────────────────────
# litellm routes "<LLM_PROVIDER>/<model>"; set the provider's own key.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=                     # CHANGEME
# Model for every agent without its own <NAME>_AGENT_MODEL (then ORCHESTRATOR_AGENT_MODEL).
AGENT_MODEL=deepseek/deepseek-v4.1-flash
# Per-agent overrides, e.g.:
# ORCHESTRATOR_AGENT_MODEL=   CLASSIFICATION_AGENT_MODEL=   REGRESSION_AGENT_MODEL=
# CLUSTERING_AGENT_MODEL=     ANOMALY_AGENT_MODEL=          FORECASTING_AGENT_MODEL=
# VISUALIZATION_AGENT_MODEL=  DRIFT_AGENT_MODEL=            SERVING_AGENT_MODEL=   EXPLAIN_AGENT_MODEL=

# ── Persistence ───────────────────────────────────────────────
# Completed training runs (metadata + hold-out predictions) are saved here.
# Defaults to a local SQLite file — no setup needed for a demo.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ── Auth ──────────────────────────────────────────────────────
# CHANGEME — any long random string. Generate: openssl rand -hex 32
# Signs dev login tokens (no OIDC_ISSUER) and, unless USER_CONTEXT_SECRET is
# set, the user context the gateway hands every agent.
JWT_SECRET=dev-secret-change-me-in-.env-min-32-bytes-long
# The key agents verify the gateway-signed user context with (every agent
# process needs the same value). Defaults to JWT_SECRET.
# USER_CONTEXT_SECRET=
# Production: refuse any agent request without a valid signed user context.
# AGENTIC_ML_REQUIRE_USER=1

# ── Keycloak / OIDC sign-in (production) ─────────────────────
# `make docker` (or `make keycloak`) starts Keycloak with realm ml-agents.
# Setting OIDC_ISSUER switches the gateway from dev tokens to Keycloak.
# OIDC_ISSUER=http://localhost:8180/realms/ml-agents
# OIDC_AUDIENCE=ml-agents
# OIDC_CLIENT_ID=ml-agents-ui
# OIDC_USER_CLAIM=preferred_username
# AGENTIC_ML_ADMIN_ROLE=ml-admin          # Keycloak realm role with admin rights
# Keycloak container (docker-compose.yml):
# KEYCLOAK_ADMIN_PASSWORD=                # CHANGEME
# KEYCLOAK_HOSTNAME=https://sso.example.com
# KEYCLOAK_COMMAND=start --import-realm   # production mode, behind a TLS proxy
# ML_AGENTS_UI_URL=https://ml.example.com # the UI's public URL (login redirect)

# ── App ───────────────────────────────────────────────────────
# Everything listens on 127.0.0.1. Use 0.0.0.0 only when the TLS proxy (or
# another agent host) is on a different machine.
APP_HOST=127.0.0.1
# AGENT_BIND=127.0.0.1
APP_PORT=9001
MAX_FILE_SIZE_MB=500

# ── Agent-to-agent auth (REQUIRED — the swarm cannot talk to itself without it)
#
# Every agent's BearerAuthMiddleware is always-on and AUTO-GENERATES a random
# key at startup when its var is unset. The orchestrator reads these same vars
# to sign its outgoing calls. Leave them unset and each side invents a
# different secret, so every delegation 401s at agent-card resolution — and
# the orchestrator turns that into an error string the LLM narrates around,
# which looks like delegation happening while nothing runs.
#
# One shared value is fine for local dev. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Give each agent its own secret before this leaves your machine.
ORCHESTRATOR_API_KEY=devkey
ORCHESTRATOR_AGENT_URL=http://localhost:9100
ORCHESTRATOR_AGENT_API_KEY=devkey
CLASSIFICATION_AGENT_URL=http://localhost:9000
CLASSIFICATION_AGENT_API_KEY=devkey
VISUALIZATION_AGENT_URL=http://localhost:9200
VISUALIZATION_AGENT_API_KEY=devkey
REGRESSION_AGENT_URL=http://localhost:9300
REGRESSION_AGENT_API_KEY=devkey
CLUSTERING_AGENT_URL=http://localhost:9400
CLUSTERING_AGENT_API_KEY=devkey
ANOMALY_AGENT_URL=http://localhost:9500
ANOMALY_AGENT_API_KEY=devkey
FORECASTING_AGENT_URL=http://localhost:9600
FORECASTING_AGENT_API_KEY=devkey
DRIFT_AGENT_URL=http://localhost:9700
DRIFT_AGENT_API_KEY=devkey
SERVING_AGENT_URL=http://localhost:9800
SERVING_AGENT_API_KEY=devkey
EXPLAIN_AGENT_URL=http://localhost:9900
EXPLAIN_AGENT_API_KEY=devkey

# Hop budget for a chained pipeline. Each delegation costs >= 2 hops
# (load_skill + the call), so a train -> chart -> export -> serve chain needs
# ~10. Too low and the orchestrator is cut off mid-pipeline.
ORCHESTRATOR_MAX_HOPS=16

# Tracing (core/tracing.py). Unset keys = every span is a no-op; the agents
# run normally, you just get no traces. Local Langfuse:
#   docker compose up -d langfuse-web langfuse-worker postgres clickhouse redis minio
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_TRACING_ENVIRONMENT=development

# ── MLflow ────────────────────────────────────────────────────
# UI over the model registry every agent logs to: `make mlflow` (also `make up`).
# 5001, not 5000 — macOS AirPlay Receiver answers localhost:5000.
MLFLOW_PORT=5001

# ── Multi-user server (defaults suit a dev laptop; set these on the shared server) ──
# Users whose actions override ownership: move a colleague's champion, open their runs.
# Everyone else can only use their own runs and move aliases off/onto their own versions.
AGENTIC_ML_ADMINS=
# Turns each specialist agent runs at once (each holds a tool process + its dataset in memory).
# Per agent: e.g. CLASSIFICATION_MAX_CONCURRENT_TURNS=8. Beyond it, requests queue.
AGENT_MAX_CONCURRENT_TURNS=4
# Durable A2A task state (a question asked before a restart can still be answered after it).
# Default: SQLite per agent under data/a2a/. Shared database for several hosts:
# A2A_TASK_DB_URL=postgresql+asyncpg://user:pass@db:5432/agentic_ml
# MLflow as ONE server every agent writes through (serializes concurrent registrations):
# MLFLOW_BACKEND_STORE_URI=postgresql://user:pass@db:5432/mlflow
# MLFLOW_ARTIFACTS_DESTINATION=/srv/agentic-ml/mlartifacts
# MLFLOW_TRACKING_URI=http://127.0.0.1:5001
# Agent conversation checkpoints (LangGraph): SQLite per agent under data/a2a/
# by default; Postgres (pip install langgraph-checkpoint-postgres "psycopg[binary,pool]"):
# AGENT_CHECKPOINT_URL=postgresql://user:pass@db:5432/agentic_ml
# Longest a single tool call may run (seconds) before it is stopped.
# AGENT_TOOL_TIMEOUT=1800
# Where browsers fetch charts; default same-origin /charts (the gateway serves them).
# CHARTS_PUBLIC_URL=https://ml.example.com/charts
# Browser origins allowed to call the gateway from elsewhere (default: same origin only).
# CORS_ORIGINS=
# A turn running longer than this is stopped (seconds).
# GATEWAY_TURN_TIMEOUT=14400
